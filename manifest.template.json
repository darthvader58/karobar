{
  "manifest_version": 3,
  "name": "Karobar",
  "key": "",
  "version": "1.0.0",
  "description": "Track job applications to Google Sheets",
  "permissions": ["identity", "storage", "tabs", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {}
  },
  "oauth2": {
    "client_id": "__GOOGLE_CLIENT_ID__",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/prompt/prompt.html", "src/content/prompt/prompt.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
